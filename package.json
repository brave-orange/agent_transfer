{
  "name": "agent-migrate",
  "version": "1.0.0",
  "description": "Cross-platform migration tool for OpenClaw and Hermes Agent configurations",
  "main": "electron/main.js",
  "bin": {
    "agent-migrate": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "node scripts/build.js",
    "test": "node tests/test.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder"
  },
  "keywords": [
    "agent",
    "migration",
    "transfer",
    "openclaw",
    "hermes"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.agentmigrate.app",
    "productName": "Agent Migrate",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "logo.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "logo.png"
    }
  }
}
